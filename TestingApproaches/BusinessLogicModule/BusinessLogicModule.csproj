<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <EnableNETAnalyzers>true</EnableNETAnalyzers>
        <AnalysisMode>All</AnalysisMode>
    </PropertyGroup>

    <ItemGroup>
        <FrameworkReference Include="Microsoft.AspNetCore.App"/>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Data.SqlClient" Version="7.1.1" />
        <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.14" />
        <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.14" />
        <PackageReference Include="MongoDB.Driver" Version="3.13.0" />
        <!-- Pins a patched version over SqlClient's vulnerable transitive
             9.0.18 (CVE-2026-84008, CVE-2026-70162). Remove once SqlClient
             ships a fixed dependency. -->
        <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.14" />
    </ItemGroup>

    <ItemGroup>
        <!-- Keeps the ReSharper/Rider settings in effect and tracked in git,
             just out of the Solution Explorer / project tree. -->
        <None Include="BusinessLogicModule.csproj.DotSettings" Visible="false"/>
    </ItemGroup>

</Project>
