resharper_place_simple_method_on_single_line = true
resharper_place_single_method_argument_lambda_on_same_line = true
resharper_place_type_attribute_on_same_line = false
resharper_prefer_separate_deconstructed_variables_declaration = true
resharper_show_autodetect_configure_formatting_tip = false
resharper_space_around_arrow_op = true
resharper_treat_case_statement_with_break_as_simple = false
resharper_use_indent_from_vs = false
resharper_wrap_after_lambda_and_anonymous_function_declaration_lpar = true
resharper_wrap_after_property_in_chained_method_calls = true
resharper_wrap_array_initializer_style = chop_always
resharper_wrap_before_arrow_with_expressions = true
resharper_wrap_before_first_method_call = false
resharper_wrap_before_lambda_and_anonymous_function_declaration_rpar = false
